generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum Usersex {
  Male
  Female
}
// ==========================================
// 1. ACADEMIC YEAR & ENROLLMENT TRACKING
// ==========================================

model AcademicYear {
  id                  String               @id @default(cuid())
  year                String               @unique // e.g., "2025/2026"
  isCurrent           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  
  enrollments         Enrollment[]
  courseRegistrations CourseRegistration[]
}

model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  academicYearId String
  levelId        Int              // The level during this academic year (100, 200, etc.)
  status         EnrollmentStatus @default(PROMOTED) // PROMOTED or GRADUATED

  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  level          Level            @relation(fields: [levelId], references: [id])

  createdAt      DateTime         @default(now())

  @@unique([studentId, academicYearId])
  @@index([levelId])
  @@index([academicYearId])
}

enum EnrollmentStatus {
  PROMOTED
  GRADUATED
}

// ==========================================
// 2. COURSE REGISTRATIONS & RESIT TRACKING
// ==========================================

enum AttemptType {
  REGULAR
  RESIT
}

enum CourseStatus {
  PENDING
  PASSED
  FAILED
}

model CourseRegistration {
  id             String       @id @default(cuid())
  studentId      String
  subjectId      Int
  academicYearId String
  type           AttemptType  @default(REGULAR)
  status         CourseStatus @default(PENDING)

  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt      DateTime     @default(now())

  @@unique([studentId, subjectId, academicYearId, type])
  @@index([studentId ,academicYearId])
  @@index([subjectId])
}

// ==========================================
// 3. UPDATED EXISTING MODELS
// ==========================================

model Student {
  id           String               @id @default(cuid())
  username     String               @unique
  email        String               @unique
  age          Int
  address      String
  phoneNumber  String               @unique
  firstName    String
  lastName     String
  image        String?
  sex          Usersex
  createdAt    DateTime             @default(now())
  parentId     String?
  departmentId String
  gradeId      String?
  levelId      Int                  // Keeps current/active level for quick queries
  matricule    String?              @unique
  DateOfBirth  DateTime?
  attendance   Attendance[]
  fees         Fee[]
  results      Result[]
  department   Department           @relation(fields: [departmentId], references: [id])
  level        Level                @relation(fields: [levelId], references: [id])
  parent       Parent?              @relation(fields: [parentId], references: [id])
  readReceipts NotificationRead[]
  
  // Updated Relations
  enrollments  Enrollment[]         // Tracks historical progression per academic year
  courseRegs   CourseRegistration[] // Explicit course registrations (Regular & Resits)

  @@index([departmentId], map: "Student_departmentId_fkey")
  @@index([levelId], map: "Student_levelId_fkey")
  @@index([parentId], map: "Student_parentId_fkey")
}

model Level {
  id          Int          @id @default(autoincrement())
  LevelName   String       @unique
  exam        Exam[]
  student     Student[]
  subjects    Subject[]
  timetables  Timetable[]
  enrollments Enrollment[] // Relation back to historical enrollments
}

model Subject {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  gradeId     String?
  levelId     Int?
  assignments Assignment[]
  attendance  Attendance[]
  exams       Exam[]
  results     Result[]
  grade       Grade?               @relation(fields: [gradeId], references: [id])
  level       Level?               @relation(fields: [levelId], references: [id])
  timetables  Timetable[]
  classrooms  Classroom[]          @relation("ClassroomToSubject")
  department  Department[]         @relation("DepartmentToSubject")
  teachers    Teacher[]            @relation("SubjectToTeacher")
  
  // Updated Relation
  registrations CourseRegistration[] // Tracks student enrollments & resits

  @@index([gradeId], map: "Subject_gradeId_fkey")
  @@index([levelId], map: "Subject_levelId_fkey")
}
model Admin {
  id            String             @id @default(cuid())
  userName      String
  email         String             @unique
  notification  Notification[]
  notifications NotificationRead[]
}

model School {
  id          String       @id @default(cuid())
  name        String       @unique
  departments Department[]
}

model Department {
  id              String           @id @default(cuid())
  name            String           @unique
  teacherId       String?
  schoolId        String?
  school          School?          @relation(fields: [schoolId], references: [id])
  announcements   Announcement[]
  supervisor      Teacher?         @relation("DepartmentSupervisor", fields: [teacherId], references: [id])
  events          Event[]
  examDepartments ExamDepartment[]
  students        Student[]
  subjects        Subject[]        @relation("DepartmentToSubject")
  chatRooms       ChatRoom[]
  timetables      Timetable[]

  @@index([teacherId], map: "Department_teacherId_fkey")
  @@index([schoolId], map: "Department_schoolId_fkey")
}

model Grade {
  id       String    @id @default(cuid())
  name     String    @unique
  subjects Subject[]
}

model Teacher {
  id            String             @id @default(cuid())
  username      String             @unique
  email         String             @unique
  address       String
  bloodGroup    String?
  phoneNumber   String             @unique
  firstName     String
  lastName      String
  sex           Usersex
  createdAt     DateTime       @default(now())
  image         String?
  DateOfBirth   DateTime?
  teachersId    String?
  department    Department[]       @relation("DepartmentSupervisor")
  notifications Notification[]
  readReceipts  NotificationRead[] // Fixed Case Name
  courses       Subject[]          @relation("SubjectToTeacher")
}

model Parent {
  id          String    @id @default(cuid())
  username    String    @unique
  email       String    @unique
  sex         Usersex
  address     String
  phoneNumber String    @unique
  firstName   String
  lastName    String
  students    Student[]
}

model Classroom {
  id         String      @id @default(cuid())
  name       String      @unique
  //  FIX: Removed disconnected courseId scalar 
  exams      Exam[]
  course     Subject[]   @relation("ClassroomToSubject")
  timetables Timetable[]
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum Semester {
  SEMESTER_1
  SEMESTER_2
}

model Timetable {
  id        String    @id @default(cuid())
  dayOfWeek DayOfWeek @default(MONDAY) // Track day of the week
  startTime String // e.g. "08:00"
  endTime   String // e.g. "10:00"
  semester  Semester  @default(SEMESTER_1) // Track semester

  // Relations
  courseId Int?
  course   Subject? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id])

  levelId Int?
  level   Level? @relation(fields: [levelId], references: [id])

  createdAt  DateTime?    @default(now())
  updatedAt  DateTime?    @updatedAt
  department Department[]

  @@index([levelId, semester, dayOfWeek ,courseId])
}

model Event {
  id           String      @id @default(cuid())
  name         String      @unique
  startDate    DateTime
  endDate      DateTime
  description  String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([departmentId], map: "Event_departmentId_fkey")
}

model Exam {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  title           String
  startDate       DateTime
  endDate         DateTime
  courseId        Int
  ClassRoomId     String
  schoolYear      String
  levelId         Int
  Invigilator     String?
  classroom       Classroom        @relation(fields: [ClassRoomId], references: [id])
  course          Subject          @relation(fields: [courseId], references: [id])
  level           Level            @relation(fields: [levelId], references: [id])
  examDepartments ExamDepartment[]
  results         Result[]

  @@index([ClassRoomId], map: "Exam_ClassRoomId_fkey")
  @@index([courseId], map: "Exam_courseId_fkey")
  @@index([levelId], map: "Exam_levelId_fkey")
}

model ExamDepartment {
  examId       Int
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  exam         Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@id([examId, departmentId])
  @@index([departmentId], map: "ExamDepartment_departmentId_fkey")
}

model Attendance {
  id        Int      @id @default(autoincrement())
  present   Boolean
  date      DateTime
  status    String
  courseId  Int
  studentId String
  course    Subject  @relation(fields: [courseId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([courseId], map: "Attendance_courseId_fkey")
  @@index([studentId], map: "Attendance_studentId_fkey")
  @@unique([courseId ,studentId,date])
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime
  courseId  Int
  course    Subject  @relation(fields: [courseId], references: [id])

  @@index([courseId], map: "Assignment_courseId_fkey")
}

model Result {
  id        Int      @id @default(autoincrement())
  CA        Int
  Exam      Int
  total     Int
  date      DateTime
  studentId String
  courseId  Int
  examId    Int?
  grade     String
  course    Subject  @relation(fields: [courseId], references: [id])
  exam      Exam?    @relation(fields: [examId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
  @@index([courseId], map: "Result_courseId_fkey")
  @@index([examId], map: "Result_examId_fkey")
}

enum ChatRoomType {
  DIRECT
  GROUP
  DEPARTMENT
}

enum ParticipantType {
  STUDENT
  TEACHER
  ADMIN
}

model ChatRoom {
  id           String            @id @default(cuid())
  type         ChatRoomType
  name         String?
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id])
  createdAt    DateTime          @default(now())
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([departmentId], map: "ChatRoom_departmentId_fkey")
}

model ChatParticipant {
  id              String          @id @default(cuid())
  roomId          String
  room            ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId   String
  participantType ParticipantType
  joinedAt        DateTime        @default(now())

  @@unique([roomId, participantId])
  @@index([participantId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  roomId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId   String
  senderName String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([roomId])
}

model Fee {
  id        String   @id @default(cuid())
  studentId String
  amount    Float
  dueDate   DateTime
  status    String
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([studentId], map: "Fee_studentId_fkey")
}

model Announcement {
  id               String             @id @default(cuid())
  title            String
  message          String             @db.Text
  date             DateTime           @default(now())
  departmentId     String?
  department       Department?        @relation(fields: [departmentId], references: [id])
  notificationRead NotificationRead[] // Fixed Case Name

  @@index([departmentId], map: "Announcement_departmentId_fkey")
}

model Notification {
  id               String             @id @default(cuid())
  title            String
  message          String
  adminId          String?
  createdAt        DateTime           @default(now())
  teacherId        String?
  admin            Admin?             @relation(fields: [adminId], references: [id], onDelete: Cascade)
  teacher          Teacher?           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  notificationRead NotificationRead[] // Fixed Case Name

  @@index([adminId], map: "Notification_adminId_fkey")
  @@index([teacherId], map: "Notification_teacherId_fkey")
}

model NotificationRead {
  id             String        @id @default(cuid())
  notificationId String
  read           Boolean       @default(false)
  readAt         DateTime?
  studentId      String?
  teacherId      String?
  adminId        String?
  announcementId String?
  admin          Admin?        @relation(fields: [adminId], references: [id])
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: NoAction) // Changed to avoid cyclic cascades
  notification   Notification  @relation(fields: [notificationId], references: [id], onDelete: NoAction) // Changed to avoid cyclic cascades
  student        Student?      @relation(fields: [studentId], references: [id])
  teacher        Teacher?      @relation(fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([teacherId])
  @@index([adminId])
  @@index([notificationId])
  @@index([announcementId])
}
